{
  "version": "v1.7.2",
  "system_name": "WAYNNE AI DESIGN SYSTEM — WADS",
  "identity": {
    "logo_text": "WAYNNE AI",
    "tagline": "Tecnologia que te acompanha.",
    "colors_institutional": {
      "azul": "#2E6BFF",
      "violeta": "#7B3FE4",
      "ciano": "#00D9FF"
    },
    "fonts": ["Space Grotesk", "Inter", "JetBrains Mono"]
  },
  "categories": {
    "eletronicos": { "label": "ELETRÔNICOS", "color": "#C6FF00", "skin": "Lima" },
    "informatica": { "label": "INFORMÁTICA", "color": "#0B03B8", "skin": "Azul" },
    "game": { "label": "GAME", "color": "#39FF14", "skin": "Verde Neon" },
    "moda": { "label": "MODA", "color": "#FF1FBF", "skin": "Magenta" },
    "casa": { "label": "CASA", "color": "#C1502E", "skin": "Terracota" },
    "beleza": { "label": "BELEZA", "color": "#FFB3A3", "skin": "Rosa" },
    "esportes": { "label": "ESPORTES", "color": "#FFB600", "skin": "Laranja" }
  },
  "layout": {
    "formats": {
      "1:1": { "width": 1080, "height": 1080 },
      "4:5": { "width": 1080, "height": 1350 }
    },
    "margins": { "safe_area": 40, "protection": 80 }
  },
  "template_structure": {
    "tag_categoria": "top_left",
    "logo": "top_center",
    "trust_badge": "top_right",
    "product_image": "center",
    "product_name": "center_below_image",
    "specs": "below_name",
    "benefits": "sides",
    "price_area": "bottom_left",
    "cta": "bottom_right",
    "footer": "bottom"
  },
  "rules": {
    "never_invent": ["preço", "desconto", "especificação", "benefício", "pagamento"],
    "omit_missing_data": true,
    "product_must_remain_central": true,
    "promo_price_larger": true,
    "no_reposition": true,
    "no_new_categories": true,
    "no_skin_mix": true
  }
}
