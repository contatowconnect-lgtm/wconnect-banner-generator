
---
import { RenderEngine } from '../renderEngine';
import { CATEGORIAS } from '../bannerData';

const produtoExemplo = {
  produto: "Produto Exemplo",
  preco: "R$ 99,90",
  precoAntigo: "R$ 149,90",
  categoria: "eletronicos",
  imagemProduto: "https://via.placeholder.com/400",
  descricao: "Descrição do produto em destaque",
  botaoTexto: "Comprar Agora",
  link: "#",
  beneficios: [
    "Benefício 1",
    "Benefício 2",
    "Benefício 3",
    "Benefício 4",
    "Benefício 5",
    "Benefício 6",
    "Benefício 7",
    "Benefício 8"
  ]
};

const tamanho = "feed";
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Waynne AI - Gerador de Banners</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --wayne-bg: #0A0B10;
      --wayne-panel: #12141C;
      --wayne-blue: #2E6BFF;
      --wayne-violet: #7B3FE4;
      --wayne-cyan: #00D9FF;
      --wayne-text: #F2F4F8;
      --wayne-muted: #8991A6;
      --wayne-line: #232733;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--wayne-bg);
      color: var(--wayne-text);
      margin: 0;
      padding: 20px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 2rem;
      margin-bottom: 2rem;
      background: linear-gradient(90deg, var(--wayne-blue), var(--wayne-violet));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .form-group {
      background: var(--wayne-panel);
      padding: 2rem;
      border-radius: 12px;
      margin-bottom: 2rem;
      border: 1px solid var(--wayne-line);
    }

    label {
      display: block;
      margin: 1rem 0 0.3rem;
      font-weight: 500;
    }

    input, select, textarea {
      width: 100%;
      padding: 0.8rem;
      border-radius: 6px;
      border: 1px solid var(--wayne-line);
      background: var(--wayne-bg);
      color: var(--wayne-text);
      font-size: 1rem;
    }

    button {
      margin-top: 1.5rem;
      padding: 1rem 2rem;
      background: linear-gradient(90deg, var(--wayne-blue), var(--wayne-violet));
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.2s;
    }

    button:hover {
      transform: scale(1.02);
    }

    .preview {
      margin-top: 3rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>WAYNNE AI — Gerador de Banners</h1>
    
    <div class="form-group">
      <h2>Dados do Produto</h2>
      
      <label for="produto">Nome do Produto</label>
      <input type="text" id="produto" placeholder="Ex: Smartphone Pro Max" value={produtoExemplo.produto} />
      
      <label for="preco">Preço</label>
      <input type="text" id="preco" placeholder="R$ 99,90" value={produtoExemplo.preco} />
      
      <label for="precoAntigo">Preço Antigo (opcional)</label>
      <input type="text" id="precoAntigo" placeholder="R$ 149,90" value={produtoExemplo.precoAntigo} />
      
      <label for="categoria">Categoria</label>
      <select id="categoria">
        {CATEGORIAS.map(cat => <option value={cat} selected={cat === produtoExemplo.categoria}>{cat}</option>)}
      </select>
      
      <label for="descricao">Descrição / Chamada</label>
      <textarea id="descricao" rows="3">{produtoExemplo.descricao}</textarea>
      
      <label for="imagemProduto">URL da Imagem do Produto</label>
      <input type="url" id="imagemProduto" value={produtoExemplo.imagemProduto} />
      
      <button onclick="gerarBanner()">Gerar Banner</button>
    </div>

    <div class="preview" id="preview">
      <h2>Pré-visualização</h2>
      <RenderEngine produto={produtoExemplo} tamanho={tamanho} />
    </div>
  </div>
</body>
</html>
