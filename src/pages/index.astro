---
import { RenderEngine } from '../renderEngine';
import { CATEGORIAS } from '../bannerData';

const produtoExemplo = {
  produto: "Smartphone Pro Max",
  preco: "R$ 2.499,00",
  precoAntigo: "R$ 3.199,00",
  categoria: "eletronicos",
  imagemProduto: "https://via.placeholder.com/500x200/1a1a2e/ffffff?text=Produto+Exemplo",
  descricao: "Tecnologia de ponta com câmera profissional e bateria de longa duração",
  botaoTexto: "Comprar Agora",
  link: "#",
  beneficios: [
    "✅ Entrega rápida em todo Brasil",
    "✅ Garantia de 1 ano",
    "✅ Pagamento em até 12x sem juros"
  ]
};

const tamanho = "feed";
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Waynne AI - Gerador de Banners</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --wayne-bg: #0A0B10;
      --wayne-panel: #12141C;
      --wayne-blue: #2E6BFF;
      --wayne-violet: #7B3FE4;
      --wayne-text: #F2F4F8;
      --wayne-muted: #8991A6;
      --wayne-line: #232733;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--wayne-bg);
      color: var(--wayne-text);
      margin: 0;
      padding: 20px;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
    }

    h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.8rem;
      margin-bottom: 2rem;
      background: linear-gradient(90deg, var(--wayne-blue), var(--wayne-violet));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .form-card {
      background: var(--wayne-panel);
      padding: 2rem;
      border-radius: 12px;
      margin-bottom: 2rem;
      border: 1px solid var(--wayne-line);
    }

    label {
      display: block;
      margin: 1rem 0 0.3rem;
      font-weight: 500;
      font-size: 0.95rem;
    }

    input, select, textarea {
      width: 100%;
      padding: 0.8rem;
      border-radius: 6px;
      border: 1px solid var(--wayne-line);
      background: var(--wayne-bg);
      color: var(--wayne-text);
      font-size: 1rem;
      box-sizing: border-box;
    }

    button {
      margin-top: 1.5rem;
      padding: 1rem 2rem;
      background: linear-gradient(90deg, var(--wayne-blue), var(--wayne-violet));
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      width: 100%;
    }

    .preview {
      margin-top: 2rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>WAYNNE AI — Gerador de Banners</h1>
    
    <div class="form-card">
      <h2>Dados do Produto</h2>
      
      <label for="produto">Nome do Produto</label>
      <input type="text" id="produto" value={produtoExemplo.produto} />
      
      <label for="preco">Preço</label>
      <input type="text" id="preco" value={produtoExemplo.preco} />
      
      <label for="precoAntigo">Preço Antigo (opcional)</label>
      <input type="text" id="precoAntigo" value={produtoExemplo.precoAntigo} />
      
      <label for="categoria">Categoria</label>
      <select id="categoria">
        {CATEGORIAS.map(cat => (
          <option value={cat} selected={cat === produtoExemplo.categoria}>
            {cat}
          </option>
        ))}
      </select>
      
      <label for="descricao">Descrição / Chamada</label>
      <textarea id="descricao" rows="3">{produtoExemplo.descricao}</textarea>
      
      <label for="imagemProduto">URL da Imagem do Produto</label>
      <input type="url" id="imagemProduto" value={produtoExemplo.imagemProduto} />
      
      <button>Gerar Banner</button>
    </div>

    <div class="preview">
      <h2>Pré-visualização</h2>
      <RenderEngine dados={produtoExemplo} tamanho={tamanho} />
    </div>
  </div>
</body>
</html>
