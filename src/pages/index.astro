---
import { RenderEngine } from '../renderEngine';
import { CATEGORIAS } from '../bannerData';

const produtoExemplo = {
  produto: "Smartphone Pro Max",
  preco: "R$ 2.499,00",
  precoAntigo: "R$ 3.199,00",
  categoria: "eletronicos",
  imagemProduto: "https://via.placeholder.com/500x200/1a1a2e/ffffff?text=Produto+Exemplo",
  descricao: "Tecnologia de ponta com câmera profissional e bateria de longa duração",
  botaoTexto: "Comprar Agora",
  link: "#",
  beneficios: [
    "✅ Entrega rápida em todo Brasil",
    "✅ Garantia de 1 ano",
    "✅ Pagamento em até 12x sem juros"
  ]
};

const tamanho = "feed";
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Waynne AI – Gerador de Banners</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --wayne-bg: #0A0B10;
      --wayne-panel: #12141C;
      --wayne-blue: #2E6BFF;
      --wayne-violet: #7B3FE4;
      --wayne-text: #F2F4F8;
      --wayne-muted: #8991A6;
    }
    * {
      box-sizing: border-box;
    }
    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--wayne-bg);
      color: var(--wayne-text);
      margin: 0;
      padding: 20px;
      line-height: 1.5;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
    }
    h1 {
      text-align: center;
      font-family: 'Space Grotesk', sans-serif;
      background: linear-gradient(90deg, var(--wayne-blue), var(--wayne-violet));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 30px;
    }
    .form-card {
      background: var(--wayne-panel);
      padding: 25px;
      border-radius: 16px;
      margin-bottom: 30px;
    }
    .form-card h2 {
      margin-top: 0;
      font-size: 18px;
    }
    label {
      display: block;
      margin: 15px 0 5px;
      font-size: 14px;
      color: var(--wayne-muted);
    }
    input, select, textarea {
      width: 100%;
      padding: 10px 12px;
      background: #1A1C25;
      border: none;
      border-radius: 8px;
      color: var(--wayne-text);
      font-size: 15px;
    }
    button {
      margin-top: 20px;
      width: 100%;
      padding: 14px;
      background: linear-gradient(90deg, var(--wayne-blue), var(--wayne-violet));
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
    }
    .preview {
      margin-top: 30px;
    }
    .preview h2 {
      font-size: 18px;
      margin-bottom: 15px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>WAYNNE AI — Gerador de Banners</h1>

    <div class="form-card">
      <h2>Dados do Produto</h2>

      <label for="produto">Nome do Produto</label>
      <input type="text" id="produto" value={produtoExemplo.produto} />

      <label for="preco">Preço</label>
      <input type="text" id="preco" value={produtoExemplo.preco} />

      <label for="precoAntigo">Preço Antigo (opcional)</label>
      <input type="text" id="precoAntigo" value={produtoExemplo.precoAntigo} />

      <label for="categoria">Categoria</label>
      <select id="categoria">
        {CATEGORIAS.map(cat => (
          <option value={cat} selected={cat === produtoExemplo.categoria}>
            {cat}
          </option>
        ))}
      </select>

      <label for="descricao">Descrição / Chamada</label>
      <textarea id="descricao" rows="3">{produtoExemplo.descricao}</textarea>

      <label for="imagemProduto">URL da Imagem do Produto</label>
      <input type="url" id="imagemProduto" value={produtoExemplo.imagemProduto} />

      <button id="btnGerar">Gerar Banner</button>
    </div>

    <div class="preview">
      <h2>Pré-visualização</h2>
      <RenderEngine dados={produtoExemplo} tamanho={tamanho} />
    </div>
  </div>

<script>
  const botaoGerar = document.getElementById('btnGerar');
  botaoGerar?.addEventListener('click', () => {
    const nomeProduto = document.getElementById('produto')?.value;
    alert(`✅ Banner de "${nomeProduto}" pronto! 🎉`);
  });
</script>
</body>
</html>
